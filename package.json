{
    "name": "vue-timeline-editor",
    "version": "0.0.1",
    "description": "Interactive timeline editor for Vue 3 (drag, resize, zoom)",
    "author": "Mohammadullah",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.umd.js",
    "module": "dist/index.es.js",
    "types": "dist/index.d.ts",
    "style": "dist/style.css",
    "exports": {
        ".": {
            "import": "./dist/index.es.js",
            "require": "./dist/index.umd.js",
            "types": "./dist/index.d.ts"
        },
        "./features": {
            "import": "./dist/features/index.js",
            "types": "./dist/features/index.d.ts"
        },
        "./style.css": "./dist/style.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -p tsconfig.build.json && vite build",
        "preview": "vite preview"
    },
    "peerDependencies": {
        "vue": "^3.3.0"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "typescript": "^5.4.0",
        "vite": "^8.0.3",
        "vue": "^3.3.0",
        "vue-tsc": "^2.2.12"
    },
    "keywords": [
        "vue",
        "timeline",
        "scheduler",
        "booking",
        "calendar",
        "drag",
        "resize",
        "timeline-editor"
    ]
}
